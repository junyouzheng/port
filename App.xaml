<Application x:Class="Port.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <SolidColorBrush x:Key="BgBrush" Color="#0C0D10"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#16181D"/>
    <SolidColorBrush x:Key="Surface2Brush" Color="#1C1F26"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#2A2E36"/>
    <SolidColorBrush x:Key="TextBrush" Color="#F3EEE4"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#8B909A"/>
    <SolidColorBrush x:Key="GoldBrush" Color="#E2B66A"/>
    <SolidColorBrush x:Key="WarmBrush" Color="#CDB892"/>
    <SolidColorBrush x:Key="TcpBrush" Color="#7EE0C3"/>
    <SolidColorBrush x:Key="TcpSoftBrush" Color="#14332C"/>
    <SolidColorBrush x:Key="UdpBrush" Color="#C9B0FF"/>
    <SolidColorBrush x:Key="UdpSoftBrush" Color="#2C2444"/>
    <SolidColorBrush x:Key="LocalBrush" Color="#9ED4AE"/>
    <SolidColorBrush x:Key="LocalSoftBrush" Color="#173228"/>
    <SolidColorBrush x:Key="AnyBrush" Color="#8EBFEE"/>
    <SolidColorBrush x:Key="AnySoftBrush" Color="#152838"/>
    <SolidColorBrush x:Key="GoldSoftBrush" Color="#3A3018"/>
    <SolidColorBrush x:Key="SystemFgBrush" Color="#9BB0C4"/>
    <SolidColorBrush x:Key="SystemSoftBrush" Color="#1A2834"/>
    <SolidColorBrush x:Key="ThirdPartyRowBrush" Color="#1A1712"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#1A242C"/>
    <LinearGradientBrush x:Key="ShellBrush" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#161A22" Offset="0"/>
      <GradientStop Color="#0C0D10" Offset="0.42"/>
      <GradientStop Color="#12141C" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentLineBrush" StartPoint="0,0" EndPoint="1,0">
      <GradientStop Color="#E2B66A" Offset="0"/>
      <GradientStop Color="#3EBEA2" Offset="0.48"/>
      <GradientStop Color="#8B7CFF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CardBorderBrush" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#4A3E28" Offset="0"/>
      <GradientStop Color="#2A2E36" Offset="0.45"/>
      <GradientStop Color="#243E44" Offset="1"/>
    </LinearGradientBrush>

    <Style x:Key="TitleButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Width" Value="40"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#2A2E36"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource TitleButton}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#8B3A3A"/>
                <Setter Property="Foreground" Value="#F3EEE4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="AccentButton" TargetType="Button">
      <Setter Property="Background" Value="#1A3D36"/>
      <Setter Property="Foreground" Value="{StaticResource TcpBrush}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Padding" Value="14,7"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#24564A"/>
                <Setter Property="Foreground" Value="#EFFFF8"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="Background" Value="#242830"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Padding" Value="12,7"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#2E333D"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ToggleChip" TargetType="ToggleButton">
      <Setter Property="Background" Value="#16181D"/>
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Padding" Value="10,6"/>
      <Setter Property="Margin" Value="8,0,0,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="bd" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#3A3018"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="#6E5428"/>
                <Setter Property="Foreground" Value="{StaticResource GoldBrush}"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#22262E"/>
              </Trigger>
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="IsChecked" Value="True"/>
                  <Condition Property="IsMouseOver" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="bd" Property="Background" Value="#4A3C1E"/>
                <Setter Property="Foreground" Value="{StaticResource GoldBrush}"/>
              </MultiTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SearchBox" TargetType="TextBox">
      <Setter Property="Background" Value="#16181D"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="CaretBrush" Value="{StaticResource GoldBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Padding" Value="10,6"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="bd" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource GoldBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="12,10"/>
    </Style>
  </Application.Resources>
</Application>
