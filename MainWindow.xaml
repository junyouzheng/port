<Window x:Class="Port.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="port"
        AutomationProperties.AutomationId="port"
        Width="1080" Height="720"
        MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        ShowInTaskbar="True"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Bahnschrift, DengXian"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        PreviewKeyDown="OnPreviewKey"
        PreviewMouseDown="OnPreviewMouse">

  <Border x:Name="ShellBorder" BorderThickness="0" Background="{StaticResource ShellBrush}">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="280"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="{StaticResource DrawerBrush}">
        <Grid Margin="16,24,16,16">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <TextBlock VerticalAlignment="Center" FontFamily="Bahnschrift" FontWeight="Light"
                     FontStretch="ExtraExpanded" FontSize="44">
            <Run Text="p"/>
            <Run Text="o" Foreground="#A8C7FA"/>
            <Run Text="rt"/>
          </TextBlock>

          <Grid Grid.Row="1" VerticalAlignment="Center">
            <TextBox x:Name="SearchBox" Style="{StaticResource SearchBox}"
                     AutomationProperties.AutomationId="search"
                     Padding="48,0,44,0"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=60}"
                     LostKeyboardFocus="OnSearchLostFocus"
                     PreviewKeyDown="OnSearchKey"/>
            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                       Foreground="{StaticResource MutedBrush}" Margin="16,0,0,0"
                       VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False"/>
            <TextBlock Text="端口、进程、路径" Margin="48,0,44,0" VerticalAlignment="Center"
                       Foreground="{StaticResource MutedBrush}" FontSize="16" IsHitTestVisible="False">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Visibility" Value="Collapsed"/>
                  <Style.Triggers>
                    <MultiDataTrigger>
                      <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Text, ElementName=SearchBox}" Value=""/>
                        <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=SearchBox}" Value="False"/>
                      </MultiDataTrigger.Conditions>
                      <Setter Property="Visibility" Value="Visible"/>
                    </MultiDataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <Button x:Name="HistoryButton" Style="{StaticResource HistoryIconButton}"
                    AutomationProperties.AutomationId="search-history"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                    Click="OnHistoryToggle" ToolTip="搜索历史">
              <TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                         Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
            </Button>
            <Popup x:Name="SearchHistoryPopup" PlacementTarget="{Binding ElementName=SearchBox}"
                   Placement="Bottom" VerticalOffset="6" StaysOpen="True"
                   AllowsTransparency="True" PopupAnimation="Fade">
              <Border x:Name="HistoryPanel" Background="#2B2930" BorderBrush="#49454F" BorderThickness="1"
                      CornerRadius="16" Padding="6" SnapsToDevicePixels="True">
                <StackPanel>
                  <TextBlock Text="最近搜索" Margin="12,6,12,4" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                  <TextBlock Text="搜索后会记在这里" Margin="12,8,12,12" Foreground="{StaticResource MutedBrush}"
                             FontSize="14" Visibility="{Binding HistoryEmptyVisibility}"/>
                  <ListBox x:Name="HistoryList" ItemsSource="{Binding SearchHistory}"
                           Background="Transparent" BorderThickness="0" Padding="0"
                           Foreground="{StaticResource TextBrush}"
                           ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                           ScrollViewer.CanContentScroll="False"
                           ItemContainerStyle="{StaticResource HistoryListItem}"
                           MaxHeight="248"
                           Visibility="{Binding HistoryListVisibility}"
                           KeyboardNavigation.TabNavigation="Once">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="32"/>
                          </Grid.ColumnDefinitions>
                          <Button Grid.Column="0" Style="{StaticResource HistoryPickButton}" Click="OnHistoryPick">
                            <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" FontSize="14"/>
                          </Button>
                          <Button Grid.Column="1" Style="{StaticResource HistoryIconButton}" Width="32" Height="32"
                                  Click="OnHistoryRemove" ToolTip="删除">
                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                          </Button>
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <Button Content="清除历史" Style="{StaticResource HistoryClearButton}" Margin="4,2,4,4"
                          Click="OnHistoryClear" Visibility="{Binding HistoryListVisibility}"/>
                </StackPanel>
              </Border>
            </Popup>
          </Grid>

          <Button Grid.Row="2" Style="{StaticResource NavSystem}" Tag="system" Click="OnNav"
                  Margin="0" VerticalAlignment="Center" >
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE770;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                         Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                         VerticalAlignment="Center" Margin="0,0,12,0"/>
              <TextBlock Text="系统" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button Grid.Row="3" Style="{StaticResource NavThird}" Tag="third" Click="OnNav"
                  Margin="0" VerticalAlignment="Center" >
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE71D;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                         Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                         VerticalAlignment="Center" Margin="0,0,12,0"/>
              <TextBlock Text="第三方" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button Grid.Row="4" Style="{StaticResource NavUdp}" Tag="udp" Click="OnNav"
                  Margin="0" VerticalAlignment="Center" >
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE701;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                         Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                         VerticalAlignment="Center" Margin="0,0,12,0"/>
              <TextBlock Text="UDP" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button Grid.Row="5" Style="{StaticResource NavExposed}" Tag="exposed" Click="OnNav"
                  Margin="0" VerticalAlignment="Center" >
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                         Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                         VerticalAlignment="Center" Margin="0,0,12,0"/>
              <TextBlock Text="对外" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button Grid.Row="6" Style="{StaticResource NavLink}" Tag="link" Click="OnNav"
                  Margin="0" VerticalAlignment="Center" >
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE71B;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                         Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                         VerticalAlignment="Center" Margin="0,0,12,0"/>
              <TextBlock Text="连接" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Grid Grid.Row="7" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="8"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ToggleButton Style="{StaticResource ToggleChip}" IsChecked="{Binding AutoRefresh}"
                          Height="48" Margin="0" Padding="8,0"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalAlignment="Center"
                          ToolTip="每 2 秒刷新。再点一次停止">
              <TextBlock Text="自动刷新" VerticalAlignment="Center"/>
            </ToggleButton>
            <ToggleButton Grid.Column="2" Style="{StaticResource ToggleChip}" IsChecked="{Binding StartupEnabled}"
                          Height="48" Margin="0" Padding="8,0"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalAlignment="Center"
                          >
              <TextBlock Text="开机自启动" VerticalAlignment="Center"/>
            </ToggleButton>
          </Grid>
          <Grid Grid.Row="8" Margin="0">
            <Button x:Name="ExitAsk" Content="退出" Style="{StaticResource ExitButton}" Click="OnExitAsk"
                    HorizontalAlignment="Stretch" />
            <Grid x:Name="ExitConfirm" Visibility="Collapsed">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Button Content="取消" Style="{StaticResource PrimaryButton}" Height="48" Padding="8,0"
                      Click="OnExitCancel" />
              <Button Grid.Column="2" Content="确认退出" Style="{StaticResource ExitButton}" Padding="8,0"
                      Click="OnExitConfirm" />
            </Grid>
          </Grid>
        </Grid>
      </Border>

      <DockPanel Grid.Column="1" Margin="24,16,24,16">
        <Grid DockPanel.Dock="Top" Height="64" Margin="8,0,8,8">
          <TextBlock Text="端口" FontFamily="DengXian" FontSize="34" FontWeight="Light" VerticalAlignment="Center"/>
          <TextBlock Text="{Binding CountText}" FontSize="14" Foreground="{StaticResource MutedBrush}"
                     HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>
        <Border x:Name="ListCard" Style="{StaticResource Card}" Padding="0" SizeChanged="OnListCardSize">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#2B2930" BorderBrush="#49454F" BorderThickness="0,0,0,1">
              <Grid Margin="16,12,16,12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="64"/>
                  <ColumnDefinition Width="1.1*" MinWidth="108"/>
                  <ColumnDefinition Width="68"/>
                  <ColumnDefinition Width="*" MinWidth="64"/>
                  <ColumnDefinition Width="80"/>
                  <ColumnDefinition Width="60"/>
                  <ColumnDefinition Width="2.4*" MinWidth="96"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="协议" Foreground="{StaticResource MutedBrush}" FontSize="12" FontWeight="Medium"/>
                <TextBlock Grid.Column="1" Text="{Binding AddressHeader}" Foreground="{StaticResource MutedBrush}" FontSize="12" FontWeight="Medium"/>
                <TextBlock Grid.Column="2" Text="{Binding PortHeader}" Foreground="{StaticResource MutedBrush}" FontSize="12" FontWeight="Medium"/>
                <TextBlock Grid.Column="3" Text="进程" Foreground="{StaticResource MutedBrush}" FontSize="12" FontWeight="Medium"/>
                <TextBlock Grid.Column="4" Text="来源" Foreground="{StaticResource MutedBrush}" FontSize="12" FontWeight="Medium"/>
                <TextBlock Grid.Column="5" Text="PID" Foreground="{StaticResource MutedBrush}" FontSize="12" FontWeight="Medium"/>
                <TextBlock Grid.Column="6" Text="路径" Foreground="{StaticResource MutedBrush}" FontSize="12" FontWeight="Medium"/>
              </Grid>
            </Border>
            <ItemsControl x:Name="PortList" Grid.Row="1" ItemsSource="{Binding Rows}"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          VirtualizingPanel.ScrollUnit="Pixel"
                          ScrollViewer.CanContentScroll="True"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Auto">
              <ItemsControl.Template>
                <ControlTemplate TargetType="ItemsControl">
                  <ScrollViewer x:Name="ListScroll" Focusable="False" CanContentScroll="True"
                                Style="{StaticResource ListScrollViewer}"
                                AutomationProperties.AutomationId="list"
                                HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                                PreviewMouseLeftButtonDown="OnListDoubleClick">
                    <ItemsPresenter />
                  </ScrollViewer>
                </ControlTemplate>
              </ItemsControl.Template>
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <VirtualizingStackPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                      <StackPanel>
                        <Border Background="Transparent" Padding="16,16,16,4" Visibility="{Binding GroupHeaderVisibility}">
                          <TextBlock Text="{Binding GroupTitle}" Foreground="{StaticResource GoldBrush}" FontSize="14" FontWeight="Medium"/>
                        </Border>
                        <Border BorderBrush="#49454F" BorderThickness="0,0,0,1" Padding="0,6" Margin="8,0">
                          <Border.ContextMenu>
                            <ContextMenu Style="{StaticResource RowMenu}" Opened="OnRowMenuOpened">
                              <MenuItem Header="复制端口" Style="{StaticResource RowMenuItem}" Click="OnCopyPort"/>
                              <MenuItem Header="复制路径" Style="{StaticResource RowMenuItem}" Click="OnCopyPath"/>
                              <MenuItem Header="打开所在文件夹" Style="{StaticResource RowMenuItem}" Click="OnOpenFolder"/>
                            </ContextMenu>
                          </Border.ContextMenu>
                          <Border.Style>
                            <Style TargetType="Border">
                              <Setter Property="Background" Value="Transparent"/>
                              <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                  <Setter Property="Background" Value="{StaticResource HoverBrush}"/>
                                </Trigger>
                              </Style.Triggers>
                            </Style>
                          </Border.Style>
                          <Grid Margin="8,6">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="64"/>
                              <ColumnDefinition Width="1.1*" MinWidth="108"/>
                              <ColumnDefinition Width="68"/>
                              <ColumnDefinition Width="*" MinWidth="64"/>
                              <ColumnDefinition Width="80"/>
                              <ColumnDefinition Width="60"/>
                              <ColumnDefinition Width="2.4*" MinWidth="96"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{Binding ProtocolBackground}" CornerRadius="8"
                                    Padding="8,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                              <TextBlock Text="{Binding Protocol}" Foreground="{Binding ProtocolForeground}"
                                         FontSize="12" FontWeight="Medium" VerticalAlignment="Center"/>
                            </Border>
                            <DockPanel Grid.Column="1" VerticalAlignment="Center" LastChildFill="True">
                              <Border DockPanel.Dock="Right" Background="{Binding HintBackground}" CornerRadius="8" Padding="8,2"
                                      Margin="8,0,0,0" VerticalAlignment="Center"
                                      Visibility="{Binding HintVisibility}">
                                <TextBlock Text="{Binding AddressHintText}" Foreground="{Binding HintForeground}" FontSize="12" FontWeight="Medium"/>
                              </Border>
                              <TextBlock Text="{Binding AddressText}" FontSize="14" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBlock Grid.Column="2" Text="{Binding Port}" FontWeight="Medium" FontSize="14"
                                       Foreground="{StaticResource GoldBrush}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="3" VerticalAlignment="Center">
                              <TextBlock Text="{Binding ProcessDisplay}" FontSize="14" TextWrapping="Wrap" ToolTip="{Binding PathTip}"/>
                              <TextBlock Text="{Binding Service}" FontSize="12" TextWrapping="Wrap"
                                         Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"
                                         Visibility="{Binding ServiceVisibility}" ToolTip="{Binding Service}"/>
                            </StackPanel>
                            <Border Grid.Column="4" Background="{Binding OriginBackground}" CornerRadius="8"
                                    Padding="8,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                              <TextBlock Text="{Binding Origin}" Foreground="{Binding OriginForeground}"
                                         FontSize="12" FontWeight="Medium"/>
                            </Border>
                            <TextBlock Grid.Column="5" Text="{Binding Pid}" VerticalAlignment="Center" FontSize="14" Foreground="{StaticResource MutedBrush}"/>
                            <TextBlock Grid.Column="6" Text="{Binding PathDisplay}" VerticalAlignment="Center" FontSize="14"
                                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" ToolTip="{Binding PathTip}"/>
                          </Grid>
                        </Border>
                      </StackPanel>
                    </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Grid.Row="1" Text="{Binding EmptyText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{StaticResource MutedBrush}" FontSize="16" Visibility="{Binding EmptyVisibility}"/>
          </Grid>
        </Border>
      </DockPanel>
    </Grid>
  </Border>
</Window>
