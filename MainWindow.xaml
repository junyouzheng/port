<Window x:Class="Port.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="本机端口与进程面板"
        AutomationProperties.AutomationId="port"
        Width="1080" Height="720"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        PreviewKeyDown="OnPreviewKey"
        StateChanged="OnStateChanged"
        Deactivated="OnDeactivated">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>

  <Border x:Name="ShellBorder" BorderThickness="0" Background="{StaticResource ShellBrush}">
    <DockPanel>
      <Border DockPanel.Dock="Top" Height="60">
        <DockPanel>
          <Border DockPanel.Dock="Bottom" Height="2" Background="{StaticResource AccentLineBrush}"/>
          <Grid Margin="22,0,18,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Border Width="28" Height="28" CornerRadius="8" Background="#241E14" Margin="0,0,12,0" VerticalAlignment="Center">
                <Grid>
                  <Ellipse Width="8" Height="8" Fill="{StaticResource GoldBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5,5,0,0"/>
                  <Ellipse Width="8" Height="8" Fill="{StaticResource TcpBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,5,5"/>
                </Grid>
              </Border>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="本机端口与进程" FontSize="15" FontWeight="SemiBold"/>
                <TextBlock Text="监听端口和占用它们的进程" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
              </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
              <Button Content="以管理员重新打开" Style="{StaticResource PrimaryButton}"
                      Visibility="{Binding ElevateVisibility}" Click="OnElevate"
                      WindowChrome.IsHitTestVisibleInChrome="True" Margin="0,0,8,0" Padding="10,5"/>
              <Border Background="#171C18" CornerRadius="8" Padding="10,5" VerticalAlignment="Center">
                <TextBlock Text="{Binding AdminText}" Foreground="{Binding AdminBrush}" FontSize="12" VerticalAlignment="Center"/>
              </Border>
              <Border Width="1" Height="18" Background="{StaticResource BorderBrush}" Margin="14,0,6,0" VerticalAlignment="Center"/>
              <ToggleButton Style="{StaticResource ToggleChip}" IsChecked="{Binding StartupEnabled}"
                            WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="登录后以管理员身份留在托盘">
                <StackPanel Orientation="Horizontal">
                  <Ellipse Width="7" Height="7" Fill="{StaticResource GoldBrush}" Margin="0,1,6,0"/>
                  <TextBlock Text="开机自启动" VerticalAlignment="Center"/>
                </StackPanel>
              </ToggleButton>
              <Button Content="退出" Style="{StaticResource ExitButton}" Click="OnExit"
                      WindowChrome.IsHitTestVisibleInChrome="True" Margin="8,0,0,0" ToolTip="退出程序"/>
            </StackPanel>
          </Grid>
        </DockPanel>
      </Border>

      <Border DockPanel.Dock="Bottom" Height="36" BorderBrush="#242830" BorderThickness="0,1,0,0">
        <Grid Margin="22,0,18,0">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
            <Ellipse Width="6" Height="6" Fill="{StaticResource TcpBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource WarmBrush}" FontSize="12" VerticalAlignment="Center"/>
          </StackPanel>
          <TextBlock Text="点到窗口外面会收进托盘" Foreground="{StaticResource MutedBrush}" FontSize="11"
                     HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>
      </Border>

      <DockPanel Margin="22,16,22,14">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="360"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
            <ToggleButton Style="{StaticResource ToggleChip}" IsChecked="{Binding IncludeSystem}"
                          Margin="0" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="显示系统端口">
              <StackPanel Orientation="Horizontal">
                <Ellipse Width="7" Height="7" Fill="{StaticResource SystemFgBrush}" Margin="0,1,6,0"/>
                <TextBlock Text="系统" VerticalAlignment="Center"/>
              </StackPanel>
            </ToggleButton>
            <ToggleButton Style="{StaticResource ToggleChip}" IsChecked="{Binding IncludeUdp}"
                          WindowChrome.IsHitTestVisibleInChrome="True">
              <StackPanel Orientation="Horizontal">
                <Ellipse Width="7" Height="7" Fill="{StaticResource UdpBrush}" Margin="0,1,6,0"/>
                <TextBlock Text="UDP" VerticalAlignment="Center"/>
              </StackPanel>
            </ToggleButton>
            <ToggleButton Style="{StaticResource ToggleChip}" IsChecked="{Binding AutoRefresh}"
                          WindowChrome.IsHitTestVisibleInChrome="True">
              <StackPanel Orientation="Horizontal">
                <Ellipse Width="7" Height="7" Fill="{StaticResource TcpBrush}" Margin="0,1,6,0"/>
                <TextBlock Text="自动刷新" VerticalAlignment="Center"/>
              </StackPanel>
            </ToggleButton>
          </StackPanel>
          <Grid Grid.Column="1" VerticalAlignment="Center">
            <TextBox x:Name="SearchBox" Style="{StaticResource SearchBox}"
                     AutomationProperties.AutomationId="search"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     WindowChrome.IsHitTestVisibleInChrome="True"/>
            <TextBlock Text="端口、进程、路径" Margin="12,0,0,0" VerticalAlignment="Center"
                       Foreground="{StaticResource MutedBrush}" IsHitTestVisible="False">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Visibility" Value="Collapsed"/>
                  <Style.Triggers>
                    <MultiDataTrigger>
                      <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Text, ElementName=SearchBox}" Value=""/>
                        <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=SearchBox}" Value="False"/>
                      </MultiDataTrigger.Conditions>
                      <Setter Property="Visibility" Value="Visible"/>
                    </MultiDataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </Grid>
          <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Border Background="#171C18" CornerRadius="8" Padding="10,5" Margin="0,0,10,0" VerticalAlignment="Center">
              <TextBlock Text="{Binding CountText}" Foreground="{StaticResource WarmBrush}" FontSize="12" VerticalAlignment="Center"/>
            </Border>
            <Button Content="刷新" Style="{StaticResource AccentButton}" Click="OnRefreshClick"
                    WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="F5"/>
          </StackPanel>
        </Grid>

        <Border x:Name="ListCard" Style="{StaticResource Card}" Padding="0" SizeChanged="OnListCardSize">
          <Grid>
            <DockPanel>
              <Border DockPanel.Dock="Top" Background="#12151B" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="16,11,20,10">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="72"/>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="84"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="96"/>
                    <ColumnDefinition Width="76"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="协议" Foreground="{StaticResource TcpBrush}" FontSize="12" Opacity="0.75"/>
                  <TextBlock Grid.Column="1" Text="地址" Foreground="{StaticResource AnyBrush}" FontSize="12" Opacity="0.75"/>
                  <TextBlock Grid.Column="2" Text="端口" Foreground="{StaticResource GoldBrush}" FontSize="12" Opacity="0.8"/>
                  <TextBlock Grid.Column="3" Text="进程" Foreground="{StaticResource WarmBrush}" FontSize="12" Opacity="0.8"/>
                  <TextBlock Grid.Column="4" Text="来源" Foreground="{StaticResource GoldBrush}" FontSize="12" Opacity="0.8"/>
                  <TextBlock Grid.Column="5" Text="PID" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                  <TextBlock Grid.Column="6" Text="路径" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                </Grid>
              </Border>
              <ScrollViewer x:Name="ListScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                            PreviewMouseLeftButtonDown="OnListDoubleClick">
                <ItemsControl ItemsSource="{Binding Rows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <StackPanel>
                        <Border Background="#12151B" Padding="16,10,16,7" Visibility="{Binding GroupHeaderVisibility}">
                          <StackPanel Orientation="Horizontal">
                            <Border Width="3" Height="14" CornerRadius="1" Background="{Binding OriginForeground}" Margin="0,1,8,0"/>
                            <TextBlock Text="{Binding GroupTitle}" Foreground="{Binding OriginForeground}" FontSize="13" FontWeight="SemiBold"/>
                          </StackPanel>
                        </Border>
                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                          <Border.Style>
                            <Style TargetType="Border">
                              <Setter Property="Background" Value="{Binding RowBackground}"/>
                              <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                  <Setter Property="Background" Value="{StaticResource HoverBrush}"/>
                                </Trigger>
                              </Style.Triggers>
                            </Style>
                          </Border.Style>
                          <Grid Margin="16,1,20,1">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="72"/>
                              <ColumnDefinition Width="240"/>
                              <ColumnDefinition Width="84"/>
                              <ColumnDefinition Width="180"/>
                              <ColumnDefinition Width="96"/>
                              <ColumnDefinition Width="76"/>
                              <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{Binding ProtocolBackground}" CornerRadius="5"
                                    Padding="7,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                              <TextBlock Text="{Binding Protocol}" Foreground="{Binding ProtocolForeground}"
                                         FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                              <TextBlock Text="{Binding Address}" FontSize="12" VerticalAlignment="Center"/>
                              <Border Background="{Binding HintBackground}" CornerRadius="4" Padding="6,1"
                                      Margin="8,0,0,0" VerticalAlignment="Center"
                                      Visibility="{Binding HintVisibility}">
                                <TextBlock Text="{Binding AddressHint}" Foreground="{Binding HintForeground}" FontSize="11"/>
                              </Border>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding Port}" FontWeight="SemiBold" FontSize="14"
                                       Foreground="{StaticResource GoldBrush}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="{Binding ProcessName}" VerticalAlignment="Center" FontSize="12"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding PathTip}"/>
                            <Border Grid.Column="4" Background="{Binding OriginBackground}" CornerRadius="5"
                                    Padding="7,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                              <TextBlock Text="{Binding Origin}" Foreground="{Binding OriginForeground}"
                                         FontSize="11" FontWeight="SemiBold"/>
                            </Border>
                            <TextBlock Grid.Column="5" Text="{Binding Pid}" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                            <TextBlock Grid.Column="6" Text="{Binding PathText}" VerticalAlignment="Center" FontSize="12"
                                       Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding PathTip}"/>
                          </Grid>
                        </Border>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </DockPanel>
            <TextBlock Text="没有匹配的监听端口" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{StaticResource MutedBrush}" Visibility="{Binding EmptyVisibility}"/>
          </Grid>
        </Border>
      </DockPanel>
    </DockPanel>
  </Border>
</Window>
